APP_NAME="Moscow Traders Wholesale"
APP_ENV=production
APP_KEY=GENERATE_ON_THE_SERVER
APP_DEBUG=false
APP_URL=https://shop.micronet.mv

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=SET_AS_DEPLOYMENT_SECRET
DB_PORT=SET_AS_DEPLOYMENT_SECRET
DB_DATABASE=SET_AS_DEPLOYMENT_SECRET
DB_USERNAME=SET_AS_DEPLOYMENT_SECRET
DB_PASSWORD=SET_AS_DEPLOYMENT_SECRET
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=moscow_traders_wholesale

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@shop.micronet.mv"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

DHIRAAGU_SMS_BASE_URL=https://messaging.dhiraagu.com.mv/v1/api
DHIRAAGU_SMS_AUTH_KEY=
DHIRAAGU_SMS_SOURCE=Micronet
DHIRAAGU_SMS_DRY_RUN=true
DHIRAAGU_SMS_CHUNK_SIZE=200
DHIRAAGU_SMS_TIMEOUT=20
